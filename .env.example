# LINE Official Account / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# OpenAI Responses API
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Local AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_TOKENS=1200
OLLAMA_KEEP_ALIVE=30m
AI_TIMEOUT_MS=90000
AI_REPORT_MAX_ROWS=50
AI_RESPONSE_CACHE_MS=300000
AI_RESPONSE_CACHE_MAX=100

# Shared FDH AI access (prefer the generated .secrets/ai-access-key file)
FDH_AI_ACCESS_KEY=
FDH_AI_KEY_FILE=
FDH_AI_SESSION_HOURS=12
FDH_AI_RATE_LIMIT_PER_MINUTE=120
FDH_AI_TRUSTED_NETWORK_AUTO_LOGIN=true
FDH_AI_COOKIE_SECURE=false

# Knowledge Vault (absolute path; defaults to this project directory)
VAULT_PATH=
VAULT_INCLUDE_EXTENSIONS=.md,.txt
VAULT_TOP_K=5
VAULT_CACHE_MS=300000
VAULT_MAX_FILE_BYTES=2500000
