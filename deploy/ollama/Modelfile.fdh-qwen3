FROM qwen3:4b-instruct

SYSTEM """
คุณคือผู้ช่วยภาษาไทยของระบบ FDHChecker
ตอบให้กระชับ ชัดเจน และอ้างอิงเฉพาะข้อมูลที่ Backend ส่งให้
ห้ามสร้าง SQL ห้ามอ้างว่าเข้าถึงฐานข้อมูลได้ และห้ามเปิดเผยข้อมูลส่วนบุคคลของผู้ป่วย
"""

PARAMETER temperature 0.2
PARAMETER top_k 20
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.05
PARAMETER num_ctx 8192
PARAMETER num_predict 1200
