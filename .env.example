# Frontend/API
VITE_API_URL=
PORT=3506
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://fdh.example.go.th
TRUST_PROXY=1
HOSXP_QUERY_MAX_DAYS=93
HOSXP_CACHE_MAX_DAYS=400
OUTBOUND_HTTP_TIMEOUT_MS=90000

# HOSxP (use a least-privilege database account)
HOSXP_HOST=127.0.0.1
HOSXP_USER=fdh_readonly
HOSXP_PASSWORD=CHANGE_ME
HOSXP_DB=hos
HOSXP_HCODE=00000

# REP / STM / INV database
REPSTM_HOST=127.0.0.1
REPSTM_USER=fdh_app
REPSTM_PASSWORD=CHANGE_ME
REPSTM_DB=repstminv

# One-time bootstrap only. Remove both values after the first admin is created.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# LINE Messaging API (keep real secrets only in .env on the server)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# U... for a user, C... for a group, or R... for a multi-person room
LINE_TARGET_ID=

# Separate LINE bot for the daily operational overview
LINE_OVERVIEW_CHANNEL_SECRET=
LINE_OVERVIEW_CHANNEL_ACCESS_TOKEN=
LINE_OVERVIEW_TARGET_ID=
LINE_OVERVIEW_REPORT_TIME=15:00
LINE_APPOINTMENT_CHANNEL_ACCESS_TOKEN=
LINE_APPOINTMENT_TARGET_ID=
LINE_APPOINTMENT_REPORT_TIME=11:00

# Local AI (Ollama)
AI_EXPORT_MAX_ROWS=2000
AI_AGENT_MAX_ROWS=200
AI_AGENT_QUERY_TIMEOUT_MS=15000
AI_CONVERSATION_TTL_MS=7200000
AI_CONVERSATION_MAX_SESSIONS=200
AI_CONVERSATION_MAX_TURNS=12
AI_LEARNING_MIN_POSITIVE=2
AI_LEARNING_MAX_EXAMPLES=300
AI_LEARNING_CACHE_MS=60000
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_TOKENS=1200
OLLAMA_KEEP_ALIVE=30m
AI_TIMEOUT_MS=90000
AI_REPORT_MAX_ROWS=50
AI_RESPONSE_CACHE_MS=300000
AI_RESPONSE_CACHE_MAX=100

# AI sessions are created automatically after an approved FDHChecker login.
# Keep the generated key in .secrets/ai-access-key instead of source control.
FDH_AI_ACCESS_KEY=
FDH_AI_KEY_FILE=
FDH_AI_SESSION_HOURS=12
FDH_AI_RATE_LIMIT_PER_MINUTE=120
FDH_AI_TRUSTED_NETWORK_AUTO_LOGIN=true
FDH_AI_COOKIE_SECURE=false

# Knowledge Vault
KSP_VAULT_PATH=
VAULT_PATH=
VAULT_INCLUDE_EXTENSIONS=.md,.txt
VAULT_TOP_K=5
VAULT_CACHE_MS=300000
VAULT_MAX_FILE_BYTES=2500000
