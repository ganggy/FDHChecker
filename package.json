{
  "name": "fdh_rect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 3507",
    "server": "tsx watch server/index.ts",
    "line:test": "node --import tsx server/lineTest.ts",
    "line:fund-errors": "node --import tsx server/fundErrorReportCli.ts",
    "line:daily-overview": "node --import tsx server/dailyWorkOverviewCli.ts",
    "line:daily-overview:dry": "node --import tsx server/dailyWorkOverviewCli.ts --dry-run",
    "line:daily-overview:scheduled": "node --import tsx server/dailyWorkOverviewCli.ts --scheduled",
    "line:duplicate-appointments": "node --import tsx server/duplicateAppointmentAlertCli.ts",
    "line:duplicate-appointments:dry": "node --import tsx server/duplicateAppointmentAlertCli.ts --dry-run",
    "line:duplicate-appointments:scheduled": "node --import tsx server/duplicateAppointmentAlertCli.ts --scheduled",
    "test": "node --import tsx --test server/requestSafety.test.ts server/mophVaccineRules.test.ts server/fdhExport.test.ts server/fdhClaimProgress.test.ts server/kidneyMonitorRules.test.ts server/repstmArchive.test.ts server/repstmManagement.test.ts server/lineMessaging.test.ts server/fundErrorReport.test.ts server/dailyWorkOverview.test.ts server/duplicateAppointmentAlert.test.ts server/fsRateRules.test.ts server/revenueOpportunityMonitor.test.ts server/ipdPreAuditRules.test.ts server/opdPreAuditRules.test.ts",
    "check:server": "tsc -p server/tsconfig.json --noEmit",
    "check": "npm run test && npm run check:server && npm run lint && npm run build",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.10.1",
    "iconv-lite": "^0.7.2",
    "mysql2": "^3.9.0",
    "playwright": "^1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
