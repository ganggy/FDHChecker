# LINE Official Account / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# OpenAI Responses API
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Local AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_TOKENS=1000
AI_TIMEOUT_MS=90000
AI_REPORT_MAX_ROWS=50

# Knowledge Vault (absolute path; defaults to this project directory)
VAULT_PATH=
VAULT_INCLUDE_EXTENSIONS=.md,.txt
VAULT_TOP_K=5
VAULT_CACHE_MS=300000
VAULT_MAX_FILE_BYTES=2500000
