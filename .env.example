# ==============================================================================
# FDH Checker - Environment Configuration Template (.env.example)
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าให้ตรงกับเครื่องและระบบของโรงพยาบาล:
#   cp .env.example .env && chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การเชื่อมต่อฐานข้อมูลโรงพยาบาล (HOSxP Database)
# ------------------------------------------------------------------------------
# รองรับทั้ง MySQL / MariaDB (ค่าเริ่มต้น) และ PostgreSQL
HOSXP_HOST=127.0.0.1
HOSXP_PORT=3306
HOSXP_USER=change_me
HOSXP_PASSWORD=change_me
HOSXP_DB=hos
# หากใช้ PostgreSQL ให้กำหนด HOSXP_DB_TYPE=postgresql และ HOSXP_PORT=5432
HOSXP_DB_TYPE=mysql

# ------------------------------------------------------------------------------
# 2. ฐานข้อมูลจัดการระบบและผู้ใช้งาน (FDH / REP STM Database)
# ------------------------------------------------------------------------------
# ใช้สำหรับเก็บ app_user, app_session, app_settings, repstm, audit log
# แนะนำให้ใช้ MySQL/MariaDB (หากไม่ระบุจะใช้ค่าเดียวกับ HOSXP_HOST)
REPSTM_HOST=127.0.0.1
REPSTM_PORT=3306
REPSTM_USER=change_me
REPSTM_PASSWORD=change_me
REPSTM_DB=repstminv

# ------------------------------------------------------------------------------
# 3. การตั้งค่า Backend Server
# ------------------------------------------------------------------------------
PORT=3506
NODE_ENV=production
# ระบุ URL สำหรับ CORS (ถ้ามีหลายตัวคั่นด้วยจุลภาค) เช่น http://localhost:3507,http://your-server:3507
# CORS_ORIGINS=http://localhost:3507

# ------------------------------------------------------------------------------
# 4. การสร้างบัญชีผู้ดูแลระบบครั้งแรก (Initial Admin Bootstrap)
# ------------------------------------------------------------------------------
# หากในฐานข้อมูลยังไม่มี Admin ใดๆ เลย สามารถระบุเพื่อให้ระบบสร้าง Admin อัตโนมัติเมื่อเริ่มระบบครั้งแรก
# (รหัสผ่านต้องมีความยาวอย่างน้อย 12 ตัวอักษร)
# หลังเข้าระบบได้แล้วให้ลบหรือ comment สองบรรทัดนี้ออก
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrongPassword123!

# ------------------------------------------------------------------------------
# 5. ระบบอัปเดตอัตโนมัติผ่านหน้าเว็บ (Self-Update via Web UI)
# ------------------------------------------------------------------------------
FDH_SELF_UPDATE_ENABLED=1
FDH_APP_DIR=/opt/FDHChecker
FDH_DEPLOY_BRANCH=main
FDH_PM2_APPS="fdh-backend fdh-frontend"
FDH_HEALTH_BASE_URL=http://127.0.0.1:3506
FDH_DEPLOY_BACKUP=0

# ------------------------------------------------------------------------------
# 6. ระบบแจ้งเตือนผ่าน LINE (LINE Bot & Daily Notification - Optional)
# ------------------------------------------------------------------------------
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_TARGET_ID=
# LINE_OVERVIEW_TARGET_ID=
# LINE_OVERVIEW_REPORT_TIME=15:00
# LINE_APPOINTMENT_TARGET_ID=
# LINE_APPOINTMENT_REPORT_TIME=11:00

# ------------------------------------------------------------------------------
# 7. ปัญญาประดิษฐ์ท้องถิ่น (Local AI / Ollama - Optional)
# ------------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# OLLAMA_EMBED_MODEL=bge-m3:latest
# OPENAI_API_KEY=
# KSP_VAULT_PATH=/opt/FDHChecker/vault

# ------------------------------------------------------------------------------
# 8. การเชื่อมต่อฐานข้อมูล รพ.สต. ในเครือข่าย CUP (PCU Herbal Reconcile - Optional)
# ------------------------------------------------------------------------------
